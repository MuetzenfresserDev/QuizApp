{
  "name": "server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js --tsconfig=tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
